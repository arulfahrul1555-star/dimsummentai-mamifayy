# ====================================================================
# DIMSUMMENTAI MAMIFFAYY - ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================
# Salin file ini menjadi `.env.local` untuk development lokal atau
# masukkan variabel berikut ke Dashboard Vercel (Project Settings -> Environment Variables)
#
# Dapatkan kredensial dari Dashboard Supabase:
# 1. Buka https://supabase.com/dashboard/project/_/settings/api
# 2. Salin "Project URL" ke NEXT_PUBLIC_SUPABASE_URL
# 3. Salin "anon public" API key ke NEXT_PUBLIC_SUPABASE_ANON_KEY
# 4. Salin "service_role secret" API key ke SUPABASE_SERVICE_ROLE_KEY
# ====================================================================

# Supabase Project URL (Contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Aman digunakan di browser / client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret Key (Wajib di backend / server-side untuk bypass RLS)
# PENTING: Jangan gunakan service_role key di sisi client (browser)!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
